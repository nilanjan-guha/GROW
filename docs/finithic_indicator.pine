//@version=6
indicator("Smart Money Concepts [LuxAlgo] + 1m Sniper Scalp Engine", "SMC Sniper", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

//---------------------------------------------------------------------------------------------------------------------}
// CONSTANTS & SETTINGS
//---------------------------------------------------------------------------------------------------------------------{
BULLISH_LEG                     = 1
BEARISH_LEG                     = 0
BULLISH                         = +1
BEARISH                         = -1

GREEN                           = #089981
RED                             = #F23645
BLUE                            = #2157f3
GRAY                            = #878b94
MONO_BULLISH                    = #b2b5be
MONO_BEARISH                    = #5d606b

HISTORICAL                      = 'Historical'
PRESENT                         = 'Present'
COLORED                         = 'Colored'
MONOCHROME                      = 'Monochrome'

ALL                             = 'All'
BOS                             = 'BOS'
CHOCH                           = 'CHoCH'

TINY                            = size.tiny
SMALL                           = size.small
NORMAL                          = size.normal

ATR                             = 'Atr'
RANGE                           = 'Cumulative Mean Range'
CLOSE                           = 'Close'
HIGHLOW                         = 'High/Low'

SOLID                           = '⎯⎯⎯'
DASHED                          = '----'
DOTTED                          = '····'

SMART_GROUP                     = 'SMC: General Settings'
INTERNAL_GROUP                  = 'SMC: Real-Time Internal Structure'
SWING_GROUP                     = 'SMC: Real-Time Swing Structure'
BLOCKS_GROUP                    = 'SMC: Order Blocks'
EQUAL_GROUP                     = 'SMC: Equal Highs & Lows (EQH/EQL)'
GAPS_GROUP                      = 'SMC: Fair Value Gaps (FVG)'
LEVELS_GROUP                    = 'SMC: Multi-Timeframe Highs & Lows'
ZONES_GROUP                     = 'SMC: Premium & Discount Zones'
SNIPER_GROUP                    = 'Institutional Sniper Engine'
ORDERFLOW_GROUP                 = 'Order Flow: Volume Delta & CVD Absorption'
INDEX_SYNC_GROUP                = 'Index & Option Chart Synchronization'
INSTIT_GROUP                    = 'Institutional Concepts: OTE / IFVG / SMT / DOL'

// SMC Inputs
modeInput                       = input.string( HISTORICAL, 'Structure History Mode', group = SMART_GROUP, options = [HISTORICAL, PRESENT])
styleInput                      = input.string( COLORED,    'Color Theme',            group = SMART_GROUP, options = [COLORED, MONOCHROME])
showTrendInput                  = input.bool(   false,      'Color Candles By Trend', group = SMART_GROUP)

showInternalsInput              = input.bool(   true,       'Show Internal Structure',group = INTERNAL_GROUP)
showInternalBullInput           = input.string( ALL,        'Bullish Structure',      group = INTERNAL_GROUP, inline = 'ibull', options = [ALL,BOS,CHOCH])
internalBullColorInput          = input.color(  GREEN,      '',                       group = INTERNAL_GROUP, inline = 'ibull')
showInternalBearInput           = input.string( ALL,        'Bearish Structure',      group = INTERNAL_GROUP, inline = 'ibear', options = [ALL,BOS,CHOCH])
internalBearColorInput          = input.color(  RED,        '',                       group = INTERNAL_GROUP, inline = 'ibear')
internalFilterConfluenceInput   = input.bool(   false,      'Confluence Filter',      group = INTERNAL_GROUP)
internalStructureSize           = input.string( TINY,       'Internal Label Size',    group = INTERNAL_GROUP, options = [TINY,SMALL,NORMAL])

showStructureInput              = input.bool(   true,       'Show Swing Structure',   group = SWING_GROUP)
showSwingBullInput              = input.string( ALL,        'Bullish Structure',      group = SWING_GROUP, inline = 'bull', options = [ALL,BOS,CHOCH])
swingBullColorInput             = input.color(  GREEN,      '',                       group = SWING_GROUP, inline = 'bull')
showSwingBearInput              = input.string( ALL,        'Bearish Structure',      group = SWING_GROUP, inline = 'bear', options = [ALL,BOS,CHOCH])
swingBearColorInput             = input.color(  RED,        '',                       group = SWING_GROUP, inline = 'bear')
swingStructureSize              = input.string( SMALL,      'Swing Label Size',       group = SWING_GROUP, options = [TINY,SMALL,NORMAL])
showSwingsInput                 = input.bool(   false,      'Show Swing Points',      group = SWING_GROUP, inline = 'swings')
swingsLengthInput               = input.int(    50,         '',                       group = SWING_GROUP, minval = 10, inline = 'swings')
showHighLowSwingsInput          = input.bool(   true,       'Show Strong/Weak High/Low', group = SWING_GROUP)

showInternalOrderBlocksInput    = input.bool(   true,       'Internal Order Blocks',  group = BLOCKS_GROUP, inline = 'iob')
internalOrderBlocksSizeInput    = input.int(    5,          '',                       group = BLOCKS_GROUP, minval = 1, maxval = 20, inline = 'iob')
showSwingOrderBlocksInput       = input.bool(   false,      'Swing Order Blocks',     group = BLOCKS_GROUP, inline = 'ob')
swingOrderBlocksSizeInput       = input.int(    5,          '',                       group = BLOCKS_GROUP, minval = 1, maxval = 20, inline = 'ob') 
orderBlockFilterInput           = input.string( 'Atr',      'Order Block Filter',     group = BLOCKS_GROUP, options = [ATR, RANGE])
orderBlockMitigationInput       = input.string( HIGHLOW,    'Order Block Mitigation', group = BLOCKS_GROUP, options = [CLOSE,HIGHLOW])
internalBullishOrderBlockColor  = input.color(  color.new(#3179f5, 80), 'Internal Bullish OB', group = BLOCKS_GROUP)
internalBearishOrderBlockColor  = input.color(  color.new(#f77c80, 80), 'Internal Bearish OB', group = BLOCKS_GROUP)
swingBullishOrderBlockColor     = input.color(  color.new(#1848cc, 80), 'Bullish OB',          group = BLOCKS_GROUP)
swingBearishOrderBlockColor     = input.color(  color.new(#b22833, 80), 'Bearish OB',          group = BLOCKS_GROUP)

showEqualHighsLowsInput         = input.bool(   true,       'Equal High/Low',         group = EQUAL_GROUP)
equalHighsLowsLengthInput       = input.int(    3,          'Bars Confirmation',      group = EQUAL_GROUP, minval = 1)
equalHighsLowsThresholdInput    = input.float(  0.1,        'Threshold (ATR fraction)',group = EQUAL_GROUP, minval = 0, maxval = 0.5, step = 0.1)
equalHighsLowsSizeInput         = input.string( TINY,       'Label Size',             group = EQUAL_GROUP, options = [TINY,SMALL,NORMAL])

showFairValueGapsInput          = input.bool(   false,      'Fair Value Gaps',        group = GAPS_GROUP)
fairValueGapsThresholdInput     = input.bool(   true,       'Auto Threshold',         group = GAPS_GROUP)
fairValueGapsTimeframeInput     = input.timeframe('',       'Timeframe',              group = GAPS_GROUP)
fairValueGapsBullColorInput     = input.color(  color.new(#00ff68, 70), 'Bullish FVG', group = GAPS_GROUP)
fairValueGapsBearColorInput     = input.color(  color.new(#ff0008, 70), 'Bearish FVG', group = GAPS_GROUP)
fairValueGapsExtendInput        = input.int(    1,          'Extend FVG',             group = GAPS_GROUP, minval = 0)

showDailyLevelsInput            = input.bool(   false,      'Daily High/Low',         group = LEVELS_GROUP, inline = 'daily')
dailyLevelsStyleInput           = input.string( SOLID,      '',                       group = LEVELS_GROUP, inline = 'daily', options = [SOLID,DASHED,DOTTED])
dailyLevelsColorInput           = input.color(  BLUE,       '',                       group = LEVELS_GROUP, inline = 'daily')
showWeeklyLevelsInput           = input.bool(   false,      'Weekly High/Low',        group = LEVELS_GROUP, inline = 'weekly')
weeklyLevelsStyleInput          = input.string( SOLID,      '',                       group = LEVELS_GROUP, inline = 'weekly', options = [SOLID,DASHED,DOTTED])
weeklyLevelsColorInput          = input.color(  BLUE,       '',                       group = LEVELS_GROUP, inline = 'weekly')
showMonthlyLevelsInput          = input.bool(   false,      'Monthly High/Low',       group = LEVELS_GROUP, inline = 'monthly')
monthlyLevelsStyleInput         = input.string( SOLID,      '',                       group = LEVELS_GROUP, inline = 'monthly', options = [SOLID,DASHED,DOTTED])
monthlyLevelsColorInput         = input.color(  BLUE,       '',                       group = LEVELS_GROUP, inline = 'monthly')

showPremiumDiscountZonesInput   = input.bool(   false,      'Premium/Discount Zones', group = ZONES_GROUP)
premiumZoneColorInput           = input.color(  RED,        'Premium Zone',           group = ZONES_GROUP)
equilibriumZoneColorInput       = input.color(  GRAY,       'Equilibrium Zone',       group = ZONES_GROUP)
discountZoneColorInput          = input.color(  GREEN,      'Discount Zone',          group = ZONES_GROUP)

// Sniper Scalp Engine Inputs
enableSniperEngine              = input.bool(   true,       'Enable Institutional Sniper Engine', group = SNIPER_GROUP)
sniperRRRatio                   = input.float(  3.0,        'Target R:R Ratio (default 3, use 4-6 for HTF)', minval=1.5, step=0.5, group = SNIPER_GROUP)
sniperRetraceRatio              = input.float(  0.5,        'OTE Retracement Entry (0.705 = ICT Golden Pocket)', minval=0.2, maxval=0.79, step=0.05, group = SNIPER_GROUP)
sniperMaxWaitBars               = input.int(    12,         'Max Wait Bars for OTE/Retest Fill', minval=3, maxval=30, group = SNIPER_GROUP)
showSniperScoreboard            = input.bool(   true,       'Show Institutional Scoreboard HUD', group = SNIPER_GROUP)
// Global ATR & Trend calculations
atr14 = ta.atr(14)
microBuffer = atr14 * 0.15
trendFilterEma   = input.bool(true, 'Strict Trend Filter (EMA 50 & 200)', group = SNIPER_GROUP)
ema50  = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
useHtfConfluence = input.bool(true, '15M HTF Zone & Sweep Confluence (Multi-Timeframe)', group = SNIPER_GROUP)
htfTimeframe     = input.timeframe('15', 'HTF Timeframe', group = SNIPER_GROUP)
minRiskAtr       = input.float(0.8, 'Minimum Swing Size / Risk (ATR Multiple)', minval=0.3, step=0.1, group = SNIPER_GROUP)
trailToBE        = input.bool(false, 'Trail SL to Break-Even at 1R', group = SNIPER_GROUP)
targetOppositeSwing = input.bool(true, 'Target Draw on Liquidity (DOL): Opposite Swing High/Low', group = SNIPER_GROUP)
cooldownBarsInput   = input.int(5, 'Trade Cooldown Bars (Prevents Chop Spam)', minval=2, maxval=20, group = SNIPER_GROUP)
useKillzones        = input.bool(true, 'Trade Only In Institutional Killzones', group = SNIPER_GROUP)
useVolumeDisplace   = input.bool(true, 'Require Displacement: Institutional Volume & Body Candle', group = SNIPER_GROUP)
volMultInput        = input.float(1.15, 'Volume Expansion Multiplier (vs 20 EMA)', minval=1.0, maxval=3.0, step=0.05, group = SNIPER_GROUP)
useWickAbsorption   = input.bool(true, 'Require Wick Absorption on Liquidity Sweeps', group = SNIPER_GROUP)

// Institutional Concepts: OTE / IFVG / SMT / DOL / BPR inputs
useOteEntry          = input.bool(true,  'OTE Entry: Optimal Trade Entry (62%-79% Fib Retracement)', group = INSTIT_GROUP)
useIFVG              = input.bool(true,  'IFVG: Detect Inverted Fair Value Gaps (Flipped FVGs)', group = INSTIT_GROUP)
useSMTDivergence     = input.bool(true,  'SMT: Detect Index vs Premium CVD Divergence', group = INSTIT_GROUP)
smtIndexTicker       = input.symbol('NSE:BANKNIFTY', 'SMT Correlated Asset Ticker (e.g. NSE:BANKNIFTY)', group = INSTIT_GROUP)
useJudasSwing        = input.bool(true,  'Judas Swing: Detect False Open Session Reversal', group = INSTIT_GROUP)
usePO3Filter         = input.bool(true,  'Power of 3: Require Accumulation-Manipulation-Distribution', group = INSTIT_GROUP)
useBPR               = input.bool(true,  'BPR: Balanced Price Range (Overlapping Bullish+Bearish FVG)', group = INSTIT_GROUP)
useDOLTargets        = input.bool(true,  'DOL: Draw on Liquidity as TP Target (PDH/PDL/EQH/EQL)', group = INSTIT_GROUP)
showInstitChecklist  = input.bool(true,  'Show Institutional Entry Checklist on Chart', group = INSTIT_GROUP)

// HTF calculations for 15M discount/premium and sweep zones
htfHigh  = request.security(syminfo.tickerid, htfTimeframe, high[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
htfLow   = request.security(syminfo.tickerid, htfTimeframe, low[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
htfClose = request.security(syminfo.tickerid, htfTimeframe, close[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
htfEma   = request.security(syminfo.tickerid, htfTimeframe, ta.ema(close, 50), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// 15M HTF Liquidity Sweep & Discount Rejection
htfSweepLow  = (low < htfLow) and (close > htfLow)
htfSweepHigh = (high > htfHigh) and (close < htfHigh)
htfInDiscount = close < htfEma
//---------------------------------------------------------------------------------------------------------------------}
// DATA STRUCTURES
//---------------------------------------------------------------------------------------------------------------------{
type alerts
    bool internalBullishBOS         = false
    bool internalBearishBOS         = false
    bool internalBullishCHoCH       = false
    bool internalBearishCHoCH       = false
    bool swingBullishBOS            = false
    bool swingBearishBOS            = false
    bool swingBullishCHoCH          = false
    bool swingBearishCHoCH          = false
    bool internalBullishOrderBlock  = false
    bool internalBearishOrderBlock  = false
    bool swingBullishOrderBlock     = false
    bool swingBearishOrderBlock     = false
    bool equalHighs                 = false
    bool equalLows                  = false
    bool bullishFairValueGap        = false
    bool bearishFairValueGap        = false

type trailingExtremes
    float top
    float bottom
    int barTime
    int barIndex
    int lastTopTime
    int lastBottomTime

type fairValueGap
    float top
    float bottom
    int bias
    box topBox
    box bottomBox

type trend
    int bias    

type equalDisplay
    line l_ine      = na
    label l_abel    = na

type pivot
    float currentLevel
    float lastLevel
    bool crossed
    int barTime     = time
    int barIndex    = bar_index

type orderBlock
    float barHigh
    float barLow
    int barTime    
    int bias

// Persistent variables
var pivot swingHigh                 = pivot.new(na,na,false)
var pivot swingLow                  = pivot.new(na,na,false)
var pivot internalHigh              = pivot.new(na,na,false)
var pivot internalLow               = pivot.new(na,na,false)
var pivot equalHigh                 = pivot.new(na,na,false)
var pivot equalLow                  = pivot.new(na,na,false)
var trend swingTrend                = trend.new(0)
var trend internalTrend             = trend.new(0)
var equalDisplay equalHighDisplay   = equalDisplay.new()
var equalDisplay equalLowDisplay    = equalDisplay.new()

var array<fairValueGap> fairValueGaps     = array.new<fairValueGap>()
var array<float> parsedHighs              = array.new<float>()
var array<float> parsedLows               = array.new<float>()
var array<float> highs                    = array.new<float>()
var array<float> lows                     = array.new<float>()
var array<int> times                      = array.new<int>()

var trailingExtremes trailing             = trailingExtremes.new()
var array<orderBlock> swingOrderBlocks    = array.new<orderBlock>()
var array<orderBlock> internalOrderBlocks = array.new<orderBlock>()
var array<box> swingOrderBlocksBoxes      = array.new<box>()
var array<box> internalOrderBlocksBoxes   = array.new<box>()

var swingBullishColor               = styleInput == MONOCHROME ? MONO_BULLISH : swingBullColorInput
var swingBearishColor               = styleInput == MONOCHROME ? MONO_BEARISH : swingBearColorInput
var fairValueGapBullishColor        = styleInput == MONOCHROME ? color.new(MONO_BULLISH,70) : fairValueGapsBullColorInput
var fairValueGapBearishColor        = styleInput == MONOCHROME ? color.new(MONO_BEARISH,70) : fairValueGapsBearColorInput
var premiumZoneColor                = styleInput == MONOCHROME ? MONO_BEARISH : premiumZoneColorInput
var discountZoneColor               = styleInput == MONOCHROME ? MONO_BULLISH : discountZoneColorInput 

varip int currentBarIndex           = bar_index
varip int lastBarIndex              = bar_index
alerts currentAlerts                = alerts.new()
var initialTime                     = time

if barstate.isfirst
    if showSwingOrderBlocksInput
        for index = 1 to swingOrderBlocksSizeInput
            swingOrderBlocksBoxes.push(box.new(na,na,na,na,xloc = xloc.bar_time,extend = extend.right))
    if showInternalOrderBlocksInput
        for index = 1 to internalOrderBlocksSizeInput
            internalOrderBlocksBoxes.push(box.new(na,na,na,na,xloc = xloc.bar_time,extend = extend.right))

bearishOrderBlockMitigationSource   = orderBlockMitigationInput == CLOSE ? close : high
bullishOrderBlockMitigationSource   = orderBlockMitigationInput == CLOSE ? close : low
atrMeasure                          = ta.atr(200)
volatilityMeasure                   = orderBlockFilterInput == ATR ? atrMeasure : ta.cum(ta.tr)/bar_index
highVolatilityBar                   = (high - low) >= (2 * volatilityMeasure)
parsedHigh                          = highVolatilityBar ? low : high
parsedLow                           = highVolatilityBar ? high : low

parsedHighs.push(parsedHigh)
parsedLows.push(parsedLow)
highs.push(high)
lows.push(low)
times.push(time)

// Track structure events for Sniper Scalper
var bool triggeredBullShift = false
var bool triggeredBearShift = false
triggeredBullShift := false
triggeredBearShift := false

//---------------------------------------------------------------------------------------------------------------------}
// FUNCTIONS
//---------------------------------------------------------------------------------------------------------------------{
leg(int size) =>
    var leg     = 0    
    newLegHigh  = high[size] > ta.highest(size)
    newLegLow   = low[size]  < ta.lowest(size)
    
    if newLegHigh
        leg := BEARISH_LEG
    else if newLegLow
        leg := BULLISH_LEG
    leg

startOfNewLeg(int leg)      => ta.change(leg) != 0
startOfBearishLeg(int leg)  => ta.change(leg) == -1
startOfBullishLeg(int leg)  => ta.change(leg) == +1

drawLabel(int labelTime, float labelPrice, string tag, color labelColor, string labelStyle) =>    
    var label l_abel = na
    if modeInput == PRESENT
        l_abel.delete()
    l_abel := label.new(chart.point.new(labelTime,na,labelPrice),tag,xloc.bar_time,color=color(na),textcolor=labelColor,style = labelStyle,size = size.small)

drawEqualHighLow(pivot p_ivot, float level, int size, bool equalHigh) =>
    equalDisplay e_qualDisplay = equalHigh ? equalHighDisplay : equalLowDisplay
    string tag          = 'EQL'
    color equalColor    = swingBullishColor
    string labelStyle   = label.style_label_up

    if equalHigh
        tag         := 'EQH'
        equalColor  := swingBearishColor
        labelStyle  := label.style_label_down

    if modeInput == PRESENT
        line.delete(e_qualDisplay.l_ine)
        label.delete(e_qualDisplay.l_abel)
        
    e_qualDisplay.l_ine  := line.new(chart.point.new(p_ivot.barTime,na,p_ivot.currentLevel), chart.point.new(time[size],na,level), xloc = xloc.bar_time, color = equalColor, style = line.style_dotted)
    labelPosition        = math.round(0.5*(p_ivot.barIndex + bar_index - size))
    e_qualDisplay.l_abel := label.new(chart.point.new(na,labelPosition,level), tag, xloc.bar_index, color = color(na), textcolor = equalColor, style = labelStyle, size = equalHighsLowsSizeInput)

getCurrentStructure(int size, bool equalHighLow = false, bool internal = false) =>        
    currentLeg  = leg(size)
    newPivot    = startOfNewLeg(currentLeg)
    pivotLow    = startOfBullishLeg(currentLeg)
    pivotHigh   = startOfBearishLeg(currentLeg)

    if newPivot
        if pivotLow
            pivot p_ivot = equalHighLow ? equalLow : internal ? internalLow : swingLow    

            if equalHighLow and math.abs(p_ivot.currentLevel - low[size]) < equalHighsLowsThresholdInput * atrMeasure                
                drawEqualHighLow(p_ivot, low[size], size, false)
                currentAlerts.equalLows := true

            p_ivot.lastLevel    := p_ivot.currentLevel
            p_ivot.currentLevel := low[size]
            p_ivot.crossed      := false
            p_ivot.barTime      := time[size]
            p_ivot.barIndex     := bar_index[size]

            if not equalHighLow and not internal
                trailing.bottom         := p_ivot.currentLevel
                trailing.barTime        := p_ivot.barTime
                trailing.barIndex       := p_ivot.barIndex
                trailing.lastBottomTime := p_ivot.barTime

            if showSwingsInput and not internal and not equalHighLow
                drawLabel(time[size], p_ivot.currentLevel, p_ivot.currentLevel < p_ivot.lastLevel ? 'LL' : 'HL', swingBullishColor, label.style_label_up)            
        else
            pivot p_ivot = equalHighLow ? equalHigh : internal ? internalHigh : swingHigh

            if equalHighLow and math.abs(p_ivot.currentLevel - high[size]) < equalHighsLowsThresholdInput * atrMeasure
                drawEqualHighLow(p_ivot,high[size],size,true)
                currentAlerts.equalHighs := true               

            p_ivot.lastLevel    := p_ivot.currentLevel
            p_ivot.currentLevel := high[size]
            p_ivot.crossed      := false
            p_ivot.barTime      := time[size]
            p_ivot.barIndex     := bar_index[size]

            if not equalHighLow and not internal
                trailing.top            := p_ivot.currentLevel
                trailing.barTime        := p_ivot.barTime
                trailing.barIndex       := p_ivot.barIndex
                trailing.lastTopTime    := p_ivot.barTime

            if showSwingsInput and not internal and not equalHighLow
                drawLabel(time[size], p_ivot.currentLevel, p_ivot.currentLevel > p_ivot.lastLevel ? 'HH' : 'LH', swingBearishColor, label.style_label_down)

// Enhanced Crisp & Distinct BOS / CHoCH Rendering
drawStructure(pivot p_ivot, string tag, color structureColor, string lineStyle, string labelStyle, string labelSize) =>    
    var line l_ine   = line.new(na,na,na,na,xloc = xloc.bar_time)
    var label l_abel = label.new(na,na)

    if modeInput == PRESENT
        l_ine.delete()
        l_abel.delete()

    midX = math.round(0.5*(p_ivot.barIndex + bar_index))
    l_ine := line.new(chart.point.new(p_ivot.barTime, na, p_ivot.currentLevel), chart.point.new(time, na, p_ivot.currentLevel), xloc.bar_time, color=structureColor, style=lineStyle, width=2)
    // Clean transparent bold text without solid background badge
    cleanTag = "--- " + tag + " ---"
    l_abel := label.new(chart.point.new(na, midX, p_ivot.currentLevel), cleanTag, xloc.bar_index, 
                        color=color(na), textcolor=structureColor, style=labelStyle, size=size.small)

deleteOrderBlocks(bool internal = false) =>
    array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks

    if orderBlocks.size() > 0
        for i = orderBlocks.size() - 1 to 0
            eachOrderBlock = orderBlocks.get(i)
            bool crossedOderBlock = false
            
            if bearishOrderBlockMitigationSource > eachOrderBlock.barHigh and eachOrderBlock.bias == BEARISH
                crossedOderBlock := true
                if internal
                    currentAlerts.internalBearishOrderBlock := true
                else
                    currentAlerts.swingBearishOrderBlock    := true
            else if bullishOrderBlockMitigationSource < eachOrderBlock.barLow and eachOrderBlock.bias == BULLISH
                crossedOderBlock := true
                if internal
                    currentAlerts.internalBullishOrderBlock := true
                else
                    currentAlerts.swingBullishOrderBlock    := true
            if crossedOderBlock                    
                orderBlocks.remove(i)

storeOrdeBlock(pivot p_ivot, bool internal = false, int bias = 0) =>
    if (not internal and showSwingOrderBlocksInput) or (internal and showInternalOrderBlocksInput)
        array<float> a_rray = na
        int parsedIndex = na

        if bias == BEARISH
            a_rray      := parsedHighs.slice(p_ivot.barIndex, bar_index)
            parsedIndex := p_ivot.barIndex + a_rray.indexof(a_rray.max())  
        else
            a_rray      := parsedLows.slice(p_ivot.barIndex, bar_index)
            parsedIndex := p_ivot.barIndex + a_rray.indexof(a_rray.min())                        

        orderBlock o_rderBlock        = orderBlock.new(parsedHighs.get(parsedIndex), parsedLows.get(parsedIndex), times.get(parsedIndex), bias)
        array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks
        
        if orderBlocks.size() >= 100
            orderBlocks.pop()
        orderBlocks.unshift(o_rderBlock)

drawOrderBlocks(bool internal = false) =>        
    array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks
    orderBlocksSize = orderBlocks.size()

    if orderBlocksSize > 0        
        maxOrderBlocks = internal ? internalOrderBlocksSizeInput : swingOrderBlocksSizeInput
        array<orderBlock> parsedOrdeBlocks = orderBlocks.slice(0, math.min(maxOrderBlocks, orderBlocksSize))
        array<box> b_oxes = internal ? internalOrderBlocksBoxes : swingOrderBlocksBoxes        

        for [index, eachOrderBlock] in parsedOrdeBlocks
            orderBlockColor = styleInput == MONOCHROME ? (eachOrderBlock.bias == BEARISH ? color.new(MONO_BEARISH,80) : color.new(MONO_BULLISH,80)) : internal ? (eachOrderBlock.bias == BEARISH ? internalBearishOrderBlockColor : internalBullishOrderBlockColor) : (eachOrderBlock.bias == BEARISH ? swingBearishOrderBlockColor : swingBullishOrderBlockColor)

            box b_ox = b_oxes.get(index)
            b_ox.set_top_left_point(chart.point.new(eachOrderBlock.barTime, na, eachOrderBlock.barHigh))
            b_ox.set_bottom_right_point(chart.point.new(last_bar_time, na, eachOrderBlock.barLow))        
            b_ox.set_border_color(internal ? na : orderBlockColor)
            b_ox.set_bgcolor(orderBlockColor)

displayStructure(bool internal = false) =>
    var bullishBar = true
    var bearishBar = true

    if internalFilterConfluenceInput
        bullishBar := high - math.max(close, open) > math.min(close, open - low)
        bearishBar := high - math.max(close, open) < math.min(close, open - low)
    
    pivot p_ivot    = internal ? internalHigh : swingHigh
    trend t_rend    = internal ? internalTrend : swingTrend

    lineStyle       = internal ? line.style_dashed : line.style_solid
    labelSize       = internal ? internalStructureSize : swingStructureSize

    extraCondition  = internal ? internalHigh.currentLevel != swingHigh.currentLevel and bullishBar : true
    bullishColor    = styleInput == MONOCHROME ? MONO_BULLISH : internal ? internalBullColorInput : swingBullColorInput

    bool bullShift = false
    bool bearShift = false

    if ta.crossover(close, p_ivot.currentLevel) and not p_ivot.crossed and extraCondition
        string tag = t_rend.bias == BEARISH ? CHOCH : BOS

        if internal
            currentAlerts.internalBullishCHoCH := tag == CHOCH
            currentAlerts.internalBullishBOS   := tag == BOS
        else
            currentAlerts.swingBullishCHoCH    := tag == CHOCH
            currentAlerts.swingBullishBOS      := tag == BOS

        p_ivot.crossed := true
        t_rend.bias    := BULLISH
        bullShift      := true

        displayCondition = internal ? showInternalsInput and (showInternalBullInput == ALL or (showInternalBullInput == BOS and tag != CHOCH) or (showInternalBullInput == CHOCH and tag == CHOCH)) : showStructureInput and (showSwingBullInput == ALL or (showSwingBullInput == BOS and tag != CHOCH) or (showSwingBullInput == CHOCH and tag == CHOCH))

        if displayCondition                        
            drawStructure(p_ivot, tag, bullishColor, lineStyle, label.style_label_down, labelSize)

        if (internal and showInternalOrderBlocksInput) or (not internal and showSwingOrderBlocksInput)
            storeOrdeBlock(p_ivot, internal, BULLISH)

    p_ivot          := internal ? internalLow : swingLow    
    extraCondition  := internal ? internalLow.currentLevel != swingLow.currentLevel and bearishBar : true
    bearishColor    = styleInput == MONOCHROME ? MONO_BEARISH : internal ? internalBearColorInput : swingBearColorInput

    if ta.crossunder(close, p_ivot.currentLevel) and not p_ivot.crossed and extraCondition
        string tag = t_rend.bias == BULLISH ? CHOCH : BOS

        if internal
            currentAlerts.internalBearishCHoCH := tag == CHOCH
            currentAlerts.internalBearishBOS   := tag == BOS
        else
            currentAlerts.swingBearishCHoCH    := tag == CHOCH
            currentAlerts.swingBearishBOS      := tag == BOS

        p_ivot.crossed := true
        t_rend.bias    := BEARISH
        bearShift      := true

        displayCondition = internal ? showInternalsInput and (showInternalBearInput == ALL or (showInternalBearInput == BOS and tag != CHOCH) or (showInternalBearInput == CHOCH and tag == CHOCH)) : showStructureInput and (showSwingBearInput == ALL or (showSwingBearInput == BOS and tag != CHOCH) or (showSwingBearInput == CHOCH and tag == CHOCH))
        
        if displayCondition                        
            drawStructure(p_ivot, tag, bearishColor, lineStyle, label.style_label_up, labelSize)

        if (internal and showInternalOrderBlocksInput) or (not internal and showSwingOrderBlocksInput)
            storeOrdeBlock(p_ivot, internal, BEARISH)

    [bullShift, bearShift]

fairValueGapBox(leftTime, rightTime, topPrice, bottomPrice, boxColor) => 
    box.new(chart.point.new(leftTime, na, topPrice), chart.point.new(rightTime + fairValueGapsExtendInput * (time-time[1]), na, bottomPrice), xloc=xloc.bar_time, border_color = boxColor, bgcolor = boxColor)

deleteFairValueGaps() =>
    if fairValueGaps.size() > 0
        for i = fairValueGaps.size() - 1 to 0
            eachFairValueGap = fairValueGaps.get(i)
            if (low < eachFairValueGap.bottom and eachFairValueGap.bias == BULLISH) or (high > eachFairValueGap.top and eachFairValueGap.bias == BEARISH)
                eachFairValueGap.topBox.delete()
                eachFairValueGap.bottomBox.delete()
                fairValueGaps.remove(i)
    
drawFairValueGaps() => 
    [lastClose, lastOpen, lastTime, currentHigh, currentLow, currentTime, last2High, last2Low] = request.security(syminfo.tickerid, fairValueGapsTimeframeInput, [close[1], open[1], time[1], high[0], low[0], time[0], high[2], low[2]], lookahead = barmerge.lookahead_on)

    barDeltaPercent     = (lastClose - lastOpen) / (lastOpen * 100)
    newTimeframe        = timeframe.change(fairValueGapsTimeframeInput)
    threshold           = fairValueGapsThresholdInput ? ta.cum(math.abs(newTimeframe ? barDeltaPercent : 0)) / bar_index * 2 : 0

    bullishFairValueGap = currentLow > last2High and lastClose > last2High and barDeltaPercent > threshold and newTimeframe
    bearishFairValueGap = currentHigh < last2Low and lastClose < last2Low and -barDeltaPercent > threshold and newTimeframe

    if bullishFairValueGap
        currentAlerts.bullishFairValueGap := true
        fairValueGaps.unshift(fairValueGap.new(currentLow, last2High, BULLISH, fairValueGapBox(lastTime, currentTime, currentLow, math.avg(currentLow, last2High), fairValueGapBullishColor), fairValueGapBox(lastTime, currentTime, math.avg(currentLow, last2High), last2High, fairValueGapBullishColor)))
    if bearishFairValueGap
        currentAlerts.bearishFairValueGap := true
        fairValueGaps.unshift(fairValueGap.new(currentHigh, last2Low, BEARISH, fairValueGapBox(lastTime, currentTime, currentHigh, math.avg(currentHigh, last2Low), fairValueGapBearishColor), fairValueGapBox(lastTime, currentTime, math.avg(currentHigh, last2Low), last2Low, fairValueGapBearishColor)))

getStyle(string style) =>
    switch style
        SOLID  => line.style_solid
        DASHED => line.style_dashed
        DOTTED => line.style_dotted

drawLevels(string timeframe, bool sameTimeframe, string style, color levelColor) =>
    [topLevel, bottomLevel, leftTime, rightTime] = request.security(syminfo.tickerid, timeframe, [high[1], low[1], time[1], time], lookahead = barmerge.lookahead_on)

    float parsedTop         = sameTimeframe ? high : topLevel
    float parsedBottom      = sameTimeframe ? low : bottomLevel    
    int parsedLeftTime      = sameTimeframe ? time : leftTime
    int parsedRightTime     = sameTimeframe ? time : rightTime
    int parsedTopTime       = time
    int parsedBottomTime    = time

    if not sameTimeframe
        int leftIndex        = times.binary_search_rightmost(parsedLeftTime)
        int rightIndex       = times.binary_search_rightmost(parsedRightTime)
        array<int> timeArray = times.slice(leftIndex, rightIndex)
        array<float> topArray = highs.slice(leftIndex, rightIndex)
        array<float> bottomArray = lows.slice(leftIndex, rightIndex)

        parsedTopTime    := timeArray.size() > 0 ? timeArray.get(topArray.indexof(topArray.max())) : initialTime
        parsedBottomTime := timeArray.size() > 0 ? timeArray.get(bottomArray.indexof(bottomArray.min())) : initialTime

    var line topLine      = line.new(na, na, na, na, xloc = xloc.bar_time, color = levelColor, style = getStyle(style))
    var line bottomLine   = line.new(na, na, na, na, xloc = xloc.bar_time, color = levelColor, style = getStyle(style))
    var label topLabel    = label.new(na, na, xloc = xloc.bar_time, text = str.format('P{0}H', timeframe), color=color(na), textcolor = levelColor, size = size.small, style = label.style_label_left)
    var label bottomLabel = label.new(na, na, xloc = xloc.bar_time, text = str.format('P{0}L', timeframe), color=color(na), textcolor = levelColor, size = size.small, style = label.style_label_left)

    topLine.set_first_point(chart.point.new(parsedTopTime, na, parsedTop))
    topLine.set_second_point(chart.point.new(last_bar_time + 20 * (time-time[1]), na, parsedTop))   
    topLabel.set_point(chart.point.new(last_bar_time + 20 * (time-time[1]), na, parsedTop))

    bottomLine.set_first_point(chart.point.new(parsedBottomTime, na, parsedBottom))    
    bottomLine.set_second_point(chart.point.new(last_bar_time + 20 * (time-time[1]), na, parsedBottom))
    bottomLabel.set_point(chart.point.new(last_bar_time + 20 * (time-time[1]), na, parsedBottom))

higherTimeframe(string timeframe) => timeframe.in_seconds() > timeframe.in_seconds(timeframe)

updateTrailingExtremes() =>
    trailing.top            := math.max(high, trailing.top)
    trailing.lastTopTime    := trailing.top == high ? time : trailing.lastTopTime
    trailing.bottom         := math.min(low, trailing.bottom)
    trailing.lastBottomTime := trailing.bottom == low ? time : trailing.lastBottomTime

drawHighLowSwings() =>
    var line topLine      = line.new(na, na, na, na, color = swingBearishColor, xloc = xloc.bar_time)
    var line bottomLine   = line.new(na, na, na, na, color = swingBullishColor, xloc = xloc.bar_time)
    var label topLabel    = label.new(na, na, color=color(na), textcolor = swingBearishColor, xloc = xloc.bar_time, style = label.style_label_down, size = size.tiny)
    var label bottomLabel = label.new(na, na, color=color(na), textcolor = swingBullishColor, xloc = xloc.bar_time, style = label.style_label_up, size = size.tiny)

    rightTimeBar = last_bar_time + 20 * (time - time[1])
    topLine.set_first_point(chart.point.new(trailing.lastTopTime, na, trailing.top))
    topLine.set_second_point(chart.point.new(rightTimeBar, na, trailing.top))
    topLabel.set_point(chart.point.new(rightTimeBar, na, trailing.top))
    topLabel.set_text(swingTrend.bias == BEARISH ? 'Strong High' : 'Weak High')

    bottomLine.set_first_point(chart.point.new(trailing.lastBottomTime, na, trailing.bottom))
    bottomLine.set_second_point(chart.point.new(rightTimeBar, na, trailing.bottom))
    bottomLabel.set_point(chart.point.new(rightTimeBar, na, trailing.bottom))
    bottomLabel.set_text(swingTrend.bias == BULLISH ? 'Strong Low' : 'Weak Low')

drawZone(float labelLevel, int labelIndex, float top, float bottom, string tag, color zoneColor, string style) =>
    var label l_abel = label.new(na, na, text = tag, color=color(na), textcolor = zoneColor, style = style, size = size.small)
    var box b_ox     = box.new(na, na, na, na, bgcolor = color.new(zoneColor,80), border_color = color(na), xloc = xloc.bar_time)

    b_ox.set_top_left_point(chart.point.new(trailing.barTime, na, top))
    b_ox.set_bottom_right_point(chart.point.new(last_bar_time, na, bottom))
    l_abel.set_point(chart.point.new(na, labelIndex, labelLevel))

drawPremiumDiscountZones() =>
    drawZone(trailing.top, math.round(0.5*(trailing.barIndex + last_bar_index)), trailing.top, 0.95*trailing.top + 0.05*trailing.bottom, 'Premium', premiumZoneColor, label.style_label_down)
    equilibriumLevel = math.avg(trailing.top, trailing.bottom)
    drawZone(equilibriumLevel, last_bar_index, 0.525*trailing.top + 0.475*trailing.bottom, 0.525*trailing.bottom + 0.475*trailing.top, 'Equilibrium', equilibriumZoneColorInput, label.style_label_left)
    drawZone(trailing.bottom, math.round(0.5*(trailing.barIndex + last_bar_index)), 0.95*trailing.bottom + 0.05*trailing.top, trailing.bottom, 'Discount', discountZoneColor, label.style_label_up)

//---------------------------------------------------------------------------------------------------------------------}
// SMC EXECUTION
//---------------------------------------------------------------------------------------------------------------------{
parsedOpen  = showTrendInput ? open : na
candleColor = internalTrend.bias == BULLISH ? swingBullishColor : swingBearishColor
plotcandle(parsedOpen, high, low, close, color = candleColor, wickcolor = candleColor, bordercolor = candleColor)

if showHighLowSwingsInput or showPremiumDiscountZonesInput
    updateTrailingExtremes()
    if showHighLowSwingsInput
        drawHighLowSwings()
    if showPremiumDiscountZonesInput
        drawPremiumDiscountZones()

if showFairValueGapsInput
    deleteFairValueGaps()

getCurrentStructure(swingsLengthInput, false)
getCurrentStructure(5, false, true)

if showEqualHighsLowsInput
    getCurrentStructure(equalHighsLowsLengthInput, true)

var bool intBull = false
var bool intBear = false
var bool swgBull = false
var bool swgBear = false

if showInternalsInput or showInternalOrderBlocksInput or showTrendInput or enableSniperEngine
    [b1, b2] = displayStructure(true)
    intBull := b1
    intBear := b2
else
    intBull := false
    intBear := false

if showStructureInput or showSwingOrderBlocksInput or showHighLowSwingsInput or enableSniperEngine
    [s1, s2] = displayStructure(false)
    swgBull := s1
    swgBear := s2
else
    swgBull := false
    swgBear := false

triggeredBullShift := intBull or swgBull
triggeredBearShift := intBear or swgBear

if showInternalOrderBlocksInput
    deleteOrderBlocks(true)

if showSwingOrderBlocksInput
    deleteOrderBlocks()

if showFairValueGapsInput
    drawFairValueGaps()

if barstate.islastconfirmedhistory or barstate.islast
    if showInternalOrderBlocksInput        
        drawOrderBlocks(true)
    if showSwingOrderBlocksInput        
        drawOrderBlocks()

lastBarIndex    := currentBarIndex
currentBarIndex := bar_index
newBar          = currentBarIndex != lastBarIndex

if barstate.islastconfirmedhistory or (barstate.isrealtime and newBar)
    if showDailyLevelsInput and not higherTimeframe('D')
        drawLevels('D', timeframe.isdaily, dailyLevelsStyleInput, dailyLevelsColorInput)
    if showWeeklyLevelsInput and not higherTimeframe('W')
        drawLevels('W', timeframe.isweekly, weeklyLevelsStyleInput, weeklyLevelsColorInput)
    if showMonthlyLevelsInput and not higherTimeframe('M')
        drawLevels('M', timeframe.ismonthly, monthlyLevelsStyleInput, monthlyLevelsColorInput)

//---------------------------------------------------------------------------------------------------------------------}
// 1M SNIPER SCALPER ENGINE (OPTIMAL RETEST & MINIMAL SL)
//---------------------------------------------------------------------------------------------------------------------{
var bool  pendingOrder      = false
var int   pendingDir        = 0 // 1: Buy limit retest, -1: Sell limit retest
var float pendingEntry      = na
var float pendingSL         = na
var float pendingTP         = na
var int   pendingSetupBar   = na
var box   pendingBox        = na

var bool  inTrade           = false
var int   tradeDir          = 0
var int   entryBarIdx       = na
var float entryPrice        = na
var float stopLossPrice     = na
var float takeProfitPrice   = na

var box   activeTPBox       = na
var box   activeSLBox       = na
var label activeLbl         = na

var int   totalWins         = 0
var int   totalLosses       = 0
var int   lastExitBar       = -999

colTPBox        = color.new(#089981, 75)
colSLBox        = color.new(#f23645, 75)
colPendingLong  = color.new(#00bcd4, 85)
colPendingShort = color.new(#e91e63, 85)

// Institutional Session Killzones (IST / Market Active Hours: 09:15-11:30 and 13:15-15:15)
// Helps avoid midday (11:30-13:15) sideways chop where fakeouts and theta decay occur
barHourMinute = hour * 100 + minute
isInKillzone  = not useKillzones or ((barHourMinute >= 915 and barHourMinute <= 1145) or (barHourMinute >= 1315 and barHourMinute <= 1515))

// Estimated Price-Action Volume Delta & Cumulative Delta (Proxy)
// NOTE: Uses bar price location and close-to-open displacement as an estimated volume delta proxy.
// Genuine tick-level trade tape delta requires exchange trade-level feed.
useOrderFlowFilter = input.bool(true, 'Require Estimated Volume Delta Confirmation', group = ORDERFLOW_GROUP)
requireCvdDivergence = input.bool(true, 'Detect Estimated Delta & CVD Absorption', group = ORDERFLOW_GROUP)
showDeltaStatsOnHud  = input.bool(true, 'Show Estimated Delta State on Scoreboard', group = ORDERFLOW_GROUP)

// High-Fidelity Synthetic Intra-Bar Order Flow Delta Estimation
// Uses tick price location and close-to-open displacement to estimate aggressive Buyer vs Seller volume
candleSpread     = math.max(high - low, syminfo.mintick)
upperWickLen     = high - math.max(open, close)
lowerWickLen     = math.min(open, close) - low
bodyLen          = math.abs(close - open)

// Relative buyer pressure (0.0 to 1.0): Price closing near high with buying wick gives high buyer ratio
buyerPressure    = ((close - low) + (close - open) * 0.5) / (candleSpread * 1.5)
buyerRatio       = math.max(0.0, math.min(1.0, 0.5 + ((close - (high + low) * 0.5) / candleSpread) * 0.5))

// Estimated aggressive buying vs aggressive selling volume
estBuyVol        = volume * buyerRatio
estSellVol       = volume * (1.0 - buyerRatio)
barDelta         = estBuyVol - estSellVol

// Cumulative Volume Delta (CVD) tracking per session
var float sessionCvd = 0.0
isNewSession = ta.change(time("D")) != 0
if isNewSession
    sessionCvd := barDelta
else
    sessionCvd := sessionCvd + barDelta

// Order Flow Metrics:
// 1. Bullish Aggressive Delta: Delta is positive and accelerating
deltaEma = ta.ema(barDelta, 9)
isPositiveDelta = barDelta > 0
isNegativeDelta = barDelta < 0
isAggressiveBullDelta = barDelta > 0 and barDelta >= deltaEma
isAggressiveBearDelta = barDelta < 0 and barDelta <= deltaEma

// 2. Order Flow Absorption (Crucial for eliminating premature Stop Losses):
// Bullish Absorption: Price swept new low (or lower low), but sellers got absorbed!
// (Delta is positive OR session CVD turns upwards while price made a low wick)
bullishAbsorption = (low <= low[1] or low <= ta.lowest(low, 3)[1]) and (close > open or lowerWickLen >= candleSpread * 0.35) and (barDelta > 0 or sessionCvd > sessionCvd[1])

// Bearish Absorption: Price pushed into high (or higher high), but buyers trapped at the top!
bearishAbsorption = (high >= high[1] or high >= ta.highest(high, 3)[1]) and (close < open or upperWickLen >= candleSpread * 0.35) and (barDelta < 0 or sessionCvd < sessionCvd[1])

// 3. CVD Divergence:
// Price drops to a swing low, but CVD makes a HIGHER LOW (Smart Money Accumulation)
cvdLowest5 = ta.lowest(sessionCvd, 5)
priceLowest5 = ta.lowest(low, 5)
bullCvdDivergence = (low <= priceLowest5) and (sessionCvd > cvdLowest5[1])

// Price pushes to a swing high, but CVD makes a LOWER HIGH (Smart Money Distribution)
cvdHighest5 = ta.highest(sessionCvd, 5)
priceHighest5 = ta.highest(high, 5)
bearCvdDivergence = (high >= priceHighest5) and (sessionCvd < cvdHighest5[1])

// Volume Expansion & Institutional Displacement Filters
volEma20          = ta.ema(volume, 20)
isVolumeExpanded  = not useVolumeDisplace or (volume >= volEma20 * volMultInput)
candleRange       = math.max(high - low, syminfo.mintick)
candleBody        = math.abs(close - open)
isDisplacement    = not useVolumeDisplace or ((candleBody / candleRange) >= 0.45 and isVolumeExpanded)

// Exhaustion Auction & Climax Detection (Blocks late entries at trend tops/bottoms)
// Volume spike >= 2.0x 20 EMA + long rejection wick or tiny body = exhaustion / retail trapped
volClimax = volume >= volEma20 * 2.0
bullExhaustion = volClimax and (upperWickLen >= candleSpread * 0.45 or (bodyLen <= candleSpread * 0.25 and close < high - candleSpread * 0.3))
bearExhaustion = volClimax and (lowerWickLen >= candleSpread * 0.45 or (bodyLen <= candleSpread * 0.25 and close > low + candleSpread * 0.3))

// Overextended / Exhaustion Filter: Price extended too far away from EMA 20 (chasing the train)
ema20 = ta.ema(close, 20)
isOverextendedLong  = close > ema20 + (atr14 * 2.8) or bullExhaustion
isOverextendedShort = close < ema20 - (atr14 * 2.8) or bearExhaustion

// Master Order Flow Filters for Entries:
orderFlowBullConfirmed = not useOrderFlowFilter or (isPositiveDelta or bullishAbsorption or (requireCvdDivergence and bullCvdDivergence))
orderFlowBearConfirmed = not useOrderFlowFilter or (isNegativeDelta or bearishAbsorption or (requireCvdDivergence and bearCvdDivergence))

// Absorption Wicks (Institutions absorbing retail supply/demand)
lowerWick         = math.min(open, close) - low
upperWick         = high - math.max(open, close)
hasLowerWickAbsorb = not useWickAbsorption or ((lowerWick / candleRange) >= 0.30)
hasUpperWickAbsorb = not useWickAbsorption or ((upperWick / candleRange) >= 0.30)

// Institutional Liquidity Sweeps with Absorption & Confirmation
sweepIntHigh   = not na(internalHigh.currentLevel) and high > internalHigh.currentLevel and close < internalHigh.currentLevel and hasUpperWickAbsorb
sweepIntLow    = not na(internalLow.currentLevel) and low < internalLow.currentLevel and close > internalLow.currentLevel and hasLowerWickAbsorb
sweepSwingHigh = not na(swingHigh.currentLevel) and high > swingHigh.currentLevel and close < swingHigh.currentLevel and hasUpperWickAbsorb
sweepSwingLow  = not na(swingLow.currentLevel) and low < swingLow.currentLevel and close > swingLow.currentLevel and hasLowerWickAbsorb

sweepHigh = sweepIntHigh or sweepSwingHigh
sweepLow  = sweepIntLow or sweepSwingLow

// Higher Trend definition: EMA 50 > EMA 200 and close > EMA 50 (Strong Trend) OR close > EMA 200
bullTrend = not trendFilterEma or (close > ema200 and ema50 >= ema200)
bearTrend = not trendFilterEma or (close < ema200 and ema50 <= ema200)

// Multi-Entry Opportunities:
// 1. Demand/Supply Order Block Pullback Touch
obDemandTouch = not na(internalLow.currentLevel) and (low <= internalLow.currentLevel + (atr14 * 0.6)) and (close > open)
obSupplyTouch = not na(internalHigh.currentLevel) and (high >= internalHigh.currentLevel - (atr14 * 0.6)) and (close < open)

// 2. FVG 50% Consequent Encroachment / Mitigation Entry:
// Detect recently formed fresh FVG touch
var float lastBullFvgMid = na
var float lastBearFvgMid = na
if currentAlerts.bullishFairValueGap
    lastBullFvgMid := (low[0] + high[2]) * 0.5
if currentAlerts.bearishFairValueGap
    lastBearFvgMid := (high[0] + low[2]) * 0.5

fvgDemandRetest = not na(lastBullFvgMid) and low <= lastBullFvgMid and close >= lastBullFvgMid and close > open
fvgSupplyRetest = not na(lastBearFvgMid) and high >= lastBearFvgMid and close <= lastBearFvgMid and close < open

// Major HTF 15M Reversal override: When price sweeps 15M low or hits 15M discount demand with bullish candle
htfMajorBuy  = useHtfConfluence and (htfSweepLow or (htfInDiscount and sweepLow)) and (close > open)
htfMajorSell = useHtfConfluence and (htfSweepHigh or (not htfInDiscount and sweepHigh)) and (close < open)

// Automatic Asset Class Identification (Index Spot vs Option Contract)
tickerUpper  = str.upper(syminfo.ticker)
isOption     = syminfo.type == 'option' or str.contains(tickerUpper, "CALL") or str.contains(tickerUpper, "PUT") or str.endswith(tickerUpper, "CE") or str.endswith(tickerUpper, "PE")
isCallOption = isOption and (str.endswith(tickerUpper, "CE") or str.contains(tickerUpper, "CALL"))
isPutOption  = isOption and (str.endswith(tickerUpper, "PE") or str.contains(tickerUpper, "PUT"))
isIndex      = str.contains(tickerUpper, "NIFTY") or str.contains(tickerUpper, "BANKNIFTY") or str.contains(tickerUpper, "SENSEX") or str.contains(tickerUpper, "FINNIFTY") or str.contains(tickerUpper, "MIDCPNIFTY") or syminfo.type == "index"

// Multi-Chart Parent Index & Option Synchronization Engine
useIndexSync         = input.bool(true, 'Enable Index & Option Chart Synchronization', group = INDEX_SYNC_GROUP)
autoIndexSymbol      = input.bool(true, 'Auto-Detect Parent Index (NIFTY / BANKNIFTY / SENSEX / FINNIFTY)', group = INDEX_SYNC_GROUP)
manualIndexSymbol    = input.symbol('INDEX:NIFTY', 'Manual Parent Index Ticker (e.g. INDEX:NIFTY or NSE:NIFTY)', group = INDEX_SYNC_GROUP)
strictIndexAlignment = input.bool(true, 'Require Parent Index Bias to Buy Option (CE=Bull, PE=Bear)', group = INDEX_SYNC_GROUP)
minOptionMomentumAtr = input.float(1.0, 'Minimum Premium Momentum/Expansion (ATR Multiplier)', minval=0.5, step=0.1, group = INDEX_SYNC_GROUP)

// Resolve the parent index symbol - Handles Dhan platform format (e.g. INDEX:NIFTY or NIFTY) and TradingView format (NSE:NIFTY)
dhanPrefix          = (syminfo.prefix == "INDEX" or str.contains(syminfo.prefix, "IDX")) ? "INDEX:" : "NSE:"
detectedIndexTicker = str.contains(tickerUpper, "BANKNIFTY") ? (dhanPrefix + "BANKNIFTY") : str.contains(tickerUpper, "FINNIFTY") ? (dhanPrefix + "FINNIFTY") : str.contains(tickerUpper, "MIDCPNIFTY") ? (dhanPrefix + "MIDCPNIFTY") : str.contains(tickerUpper, "SENSEX") ? "BSE:SENSEX" : (dhanPrefix + "NIFTY")
parentIndexTicker   = (not autoIndexSymbol and manualIndexSymbol != "") ? manualIndexSymbol : detectedIndexTicker

// Fetch Parent Index Price Action & Market Structure (Only active when viewing an Option Chart)
// CRITICAL: Request previous COMPLETED candle [1] to avoid provisional/forming candle repainting
[idxOpenRaw, idxHighRaw, idxLowRaw, idxCloseRaw, idxEma50Raw, idxEma200Raw] = request.security(parentIndexTicker, timeframe.period, [open[1], high[1], low[1], close[1], ta.ema(close, 50)[1], ta.ema(close, 200)[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// Robust Fallback: If Dhan/Exchange prefix caused NaN, fallback to standard NSE ticker
idxClose = not na(idxCloseRaw) ? idxCloseRaw : request.security("NSE:NIFTY", timeframe.period, close[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
idxOpen  = not na(idxOpenRaw) ? idxOpenRaw : request.security("NSE:NIFTY", timeframe.period, open[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
idxHigh  = not na(idxHighRaw) ? idxHighRaw : request.security("NSE:NIFTY", timeframe.period, high[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
idxLow   = not na(idxLowRaw) ? idxLowRaw : request.security("NSE:NIFTY", timeframe.period, low[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
idxEma50 = not na(idxEma50Raw) ? idxEma50Raw : request.security("NSE:NIFTY", timeframe.period, ta.ema(close, 50)[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
idxEma200= not na(idxEma200Raw) ? idxEma200Raw : request.security("NSE:NIFTY", timeframe.period, ta.ema(close, 200)[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// Parent Index Trend & Structural Shift Metrics (Computed on Previous Completed Index Candle):
// 1. Index Trend Alignment (EMA 50 & 200)
idxBullTrend = idxClose > idxEma50 and idxEma50 >= idxEma200
idxBearTrend = idxClose < idxEma50 and idxEma50 <= idxEma200

// 2. Index Displacement / Momentum Shift
idxCandleBody = math.abs(idxClose - idxOpen)
idxCandleRange = math.max(idxHigh - idxLow, syminfo.mintick)
idxBullDisplacement = idxClose > idxOpen and (idxCandleBody / idxCandleRange) >= 0.35 and idxClose > idxEma50
idxBearDisplacement = idxClose < idxOpen and (idxCandleBody / idxCandleRange) >= 0.35 and idxClose < idxEma50

// 3. Index Structure Shift (Immediate break of recent highs/lows)
idxHighRaw3 = request.security(parentIndexTicker, timeframe.period, ta.highest(high, 5)[2], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
idxLowRaw3  = request.security(parentIndexTicker, timeframe.period, ta.lowest(low, 5)[2], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
idxHigh3    = not na(idxHighRaw3) ? idxHighRaw3 : request.security("NSE:NIFTY", timeframe.period, ta.highest(high, 5)[2], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
idxLow3     = not na(idxLowRaw3) ? idxLowRaw3 : request.security("NSE:NIFTY", timeframe.period, ta.lowest(low, 5)[2], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

idxBullBreak = not na(idxHigh3) and idxClose > idxHigh3
idxBearBreak = not na(idxLow3) and idxClose < idxLow3

// Absolute True Directional Bias of Parent Index:
indexIsBullish = (idxBullTrend or idxBullDisplacement or idxBullBreak) and (idxClose > idxOpen or idxClose > idxEma50)
indexIsBearish = (idxBearTrend or idxBearDisplacement or idxBearBreak) and (idxClose < idxOpen or idxClose < idxEma50)

// Parent Index Permission Rules for Options:
// If on CALL option chart: Parent Index MUST be Bullish. ABSOLUTELY FORBIDDEN if Index is Bearish!
parentBullConfirmed = not (isCallOption and useIndexSync and strictIndexAlignment) or (indexIsBullish and not indexIsBearish)

// If on PUT option chart: Parent Index MUST be Bearish. ABSOLUTELY FORBIDDEN if Index is Bullish!
parentBearConfirmed = not (isPutOption and useIndexSync and strictIndexAlignment) or (indexIsBearish and not indexIsBullish)

// Premium Movement & Liquidity Filter:
// Prevents taking signals when premium is dead/flat-lining or experiencing theta decay with no volume
premiumRange3       = ta.highest(high, 3) - ta.lowest(low, 3)
hasPremiumExpansion = not isOption or (premiumRange3 >= atr14 * minOptionMomentumAtr and volume >= ta.ema(volume, 10) * 0.75)

//---------------------------------------------------------------------------------------------------------------------}
// INSTITUTIONAL CONCEPTS ENGINE (OTE / IFVG / SMT / BPR / DOL / PO3 / Judas Swing)
//---------------------------------------------------------------------------------------------------------------------{

// ── 1. OTE (Optimal Trade Entry) – ICT Golden Pocket: 62% / 70.5% / 79% Fibonacci Retracement ──
// After MSS + Displacement, institution fills orders at the Fibonacci OTE zone inside the FVG/OB
var float oteSwingHigh  = na
var float oteSwingLow   = na
var int   oteOriginBar  = -999
var int   oteDir        = 0  // 1 = bullish OTE setup, -1 = bearish OTE setup

// Record the swing origin when structure shifts happen
if triggeredBullShift
    oteSwingLow   := ta.lowest(low, 10)
    oteSwingHigh  := internalHigh.currentLevel
    oteOriginBar  := bar_index
    oteDir        := 1
if triggeredBearShift
    oteSwingHigh  := ta.highest(high, 10)
    oteSwingLow   := internalLow.currentLevel
    oteOriginBar  := bar_index
    oteDir        := -1

oteRange      = not na(oteSwingHigh) and not na(oteSwingLow) ? oteSwingHigh - oteSwingLow : na
// Golden Pocket: 62% to 79% retracement (ICT OTE zone)
oteBullFib62  = not na(oteRange) ? oteSwingHigh - oteRange * 0.62 : na
oteBullFib705 = not na(oteRange) ? oteSwingHigh - oteRange * 0.705 : na
oteBullFib79  = not na(oteRange) ? oteSwingHigh - oteRange * 0.79 : na
oteBearFib62  = not na(oteRange) ? oteSwingLow  + oteRange * 0.62 : na
oteBearFib705 = not na(oteRange) ? oteSwingLow  + oteRange * 0.705 : na
oteBearFib79  = not na(oteRange) ? oteSwingLow  + oteRange * 0.79 : na

// OTE Hit: Price retraces into the Golden Pocket zone after displacement
oteWindowBars  = 15
bullOteHit = useOteEntry and oteDir == 1 and (bar_index - oteOriginBar <= oteWindowBars) and not na(oteBullFib62) and low <= oteBullFib62 and low >= oteBullFib79 and close > open
bearOteHit = useOteEntry and oteDir == -1 and (bar_index - oteOriginBar <= oteWindowBars) and not na(oteBearFib62) and high >= oteBearFib62 and high <= oteBearFib79 and close < open

// ── 2. IFVG (Inverted Fair Value Gap) – Former FVG flips to opposing side ──
// A Bullish FVG that price breaks back through becomes a Bearish IFVG (resistance). Vice versa.
var bool lastFvgWasBullish = false
var float ifvgTop = na
var float ifvgBottom = na
var int   ifvgBias = 0  // 1 = bullish IFVG (demand), -1 = bearish IFVG (supply)

if currentAlerts.bullishFairValueGap
    lastFvgWasBullish := true
    ifvgTop    := low
    ifvgBottom := high[2]
    ifvgBias   := 1
if currentAlerts.bearishFairValueGap
    lastFvgWasBullish := false
    ifvgTop    := low[2]
    ifvgBottom := high
    ifvgBias   := -1

// IFVG Flip: If price re-enters the former FVG from the opposite direction, it becomes an IFVG
bullIFVGRetest = useIFVG and ifvgBias == -1 and not na(ifvgTop) and low <= ifvgTop and close >= ifvgTop and close > open
bearIFVGRetest = useIFVG and ifvgBias == 1 and not na(ifvgBottom) and high >= ifvgBottom and close <= ifvgBottom and close < open

// ── 3. Balanced Price Range (BPR) – Bullish FVG + Bearish FVG overlapping zone ──
// When two FVGs overlap, it creates a high-probability institutional reaction zone
var float bprBull = na
var float bprBear = na
if currentAlerts.bullishFairValueGap and currentAlerts.bearishFairValueGap
    bprBull := low
    bprBear := high[2]

bprBullRetest = useBPR and not na(bprBull) and low <= bprBull and close >= bprBull and close > open
bprBearRetest = useBPR and not na(bprBear) and high >= bprBear and close <= bprBear and close < open

// ── 4. SMT Divergence (Smart Money Technique) ──
// Correlated index divergence: Nifty makes HH but BankNifty makes LH → bearish SMT divergence
smtClose = request.security(smtIndexTicker, timeframe.period, close[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
smtHigh  = request.security(smtIndexTicker, timeframe.period, ta.highest(high, 5)[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
smtLow   = request.security(smtIndexTicker, timeframe.period, ta.lowest(low, 5)[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

priceHigh5 = ta.highest(high, 5)[1]
priceLow5  = ta.lowest(low, 5)[1]

// Bearish SMT: Current chart makes new HH but SMT correlated asset fails to make HH (LH)
bearSMTDiv = useSMTDivergence and not na(smtHigh) and high >= priceHigh5 and smtClose < smtHigh * 0.9995
// Bullish SMT: Current chart makes new LL but SMT correlated asset fails to make LL (HL)
bullSMTDiv = useSMTDivergence and not na(smtLow) and low <= priceLow5 and smtClose > smtLow * 1.0005

// ── 5. Judas Swing Detection ──
// False move at session open (09:15 IST) before the real institutional direction
var float sessionOpenPrice  = na
var float sessionHigh15min  = na
var float sessionLow15min   = na
var int   sessionOpenBar    = -999

barHourMin = hour * 100 + minute
isSessionOpen = barHourMin == 915
if isSessionOpen
    sessionOpenPrice := open
    sessionHigh15min := high
    sessionLow15min  := low
    sessionOpenBar   := bar_index
else if bar_index - sessionOpenBar <= 15
    sessionHigh15min := math.max(sessionHigh15min, high)
    sessionLow15min  := math.min(sessionLow15min, low)

// Judas Swing Bull: Session opened with a dip (manipulation low), then reversed with strong close above open
judasSwingBull = useJudasSwing and not na(sessionOpenPrice) and (bar_index - sessionOpenBar >= 3 and bar_index - sessionOpenBar <= 20) and (sessionLow15min < sessionOpenPrice) and (close > sessionOpenPrice) and close > open and barDelta > 0

// Judas Swing Bear: Session opened with a pop (manipulation high), then reversed with strong close below open  
judasSwingBear = useJudasSwing and not na(sessionOpenPrice) and (bar_index - sessionOpenBar >= 3 and bar_index - sessionOpenBar <= 20) and (sessionHigh15min > sessionOpenPrice) and (close < sessionOpenPrice) and close < open and barDelta < 0

// ── 6. Power of Three (PO3): Accumulation → Manipulation → Distribution ──
// Institutions: Accumulate in range, manipulate retail stops, then distribute in real direction
var float accumulationHigh = na
var float accumulationLow  = na
var int   po3Phase         = 0  // 0=scanning, 1=accumulation, 2=manipulation, 3=distribution

// Detect Accumulation: Range-bound 5-bar environment (ATR compression)
rangeCompression = (ta.highest(high, 5) - ta.lowest(low, 5)) < atr14 * 1.5
if rangeCompression and po3Phase == 0
    accumulationHigh := ta.highest(high, 5)
    accumulationLow  := ta.lowest(low, 5)
    po3Phase         := 1

// Manipulation: Price breaks above/below accumulation range (stop hunt)
po3ManipBull = usePO3Filter and po3Phase == 1 and not na(accumulationLow) and low < accumulationLow and close > accumulationLow
po3ManipBear = usePO3Filter and po3Phase == 1 and not na(accumulationHigh) and high > accumulationHigh and close < accumulationHigh
if po3ManipBull or po3ManipBear
    po3Phase := 2

// Distribution (real move): After manipulation, strong directional candle confirms
po3DistBull = usePO3Filter and po3Phase == 2 and triggeredBullShift
po3DistBear = usePO3Filter and po3Phase == 2 and triggeredBearShift
if po3DistBull or po3DistBear
    po3Phase := 3

// Reset PO3 after distribution completes or after 30 bars
if po3Phase == 3 and bar_index - oteOriginBar > 30
    po3Phase := 0

// ── 7. Draw on Liquidity (DOL) – Price magnet targeting next institutional liquidity pool ──
// Equal Highs (EQH), Equal Lows (EQL), Previous Day High/Low are institutional targets
dolBullTarget = not na(equalHigh.currentLevel) ? equalHigh.currentLevel : swingHigh.currentLevel
dolBearTarget = not na(equalLow.currentLevel) ? equalLow.currentLevel : swingLow.currentLevel

// DOL TP: If there is a DOL magnet in the direction of the trade, use it as the TP target
hasBullDOL = useDOLTargets and not na(dolBullTarget) and dolBullTarget > close + (atr14 * 1.0)
hasBearDOL = useDOLTargets and not na(dolBearTarget) and dolBearTarget < close - (atr14 * 1.0)

// ── 8. Institutional Confluence Score (All 37 concepts weighted) ──
// Minimum score to trigger an entry — prevents any single-condition signals
var int lastInstitScoreBar = -999
var int lastInstitScore = 0

institutBullScore = 0
institutBullScore := institutBullScore + (triggeredBullShift ? 2 : 0)                 // CHoCH/BOS MSS       (+2)
institutBullScore := institutBullScore + (sweepLow ? 2 : 0)                            // Liquidity SSL Sweep  (+2)
institutBullScore := institutBullScore + (bullishAbsorption ? 2 : 0)                   // Order Flow Absorption(+2)
institutBullScore := institutBullScore + (bullOteHit ? 2 : 0)                          // OTE Golden Pocket    (+2)
institutBullScore := institutBullScore + (bullSMTDiv ? 2 : 0)                          // SMT Divergence       (+2)
institutBullScore := institutBullScore + (judasSwingBull ? 1 : 0)                      // Judas Swing          (+1)
institutBullScore := institutBullScore + (po3ManipBull or po3DistBull ? 1 : 0)         // PO3 Phase            (+1)
institutBullScore := institutBullScore + (bullIFVGRetest ? 1 : 0)                      // IFVG Demand          (+1)
institutBullScore := institutBullScore + (bprBullRetest ? 1 : 0)                       // BPR Zone             (+1)
institutBullScore := institutBullScore + (htfMajorBuy ? 1 : 0)                         // 15M HTF Confluence   (+1)
institutBullScore := institutBullScore + (obDemandTouch ? 1 : 0)                       // OB Demand Touch      (+1)
institutBullScore := institutBullScore + (fvgDemandRetest ? 1 : 0)                     // FVG CE Retest        (+1)
institutBullScore := institutBullScore + (isInKillzone ? 1 : 0)                        // Killzone             (+1)
institutBullScore := institutBullScore + (isPositiveDelta ? 1 : 0)                     // Order Flow Delta     (+1)
institutBullScore := institutBullScore + (parentBullConfirmed ? 1 : 0)                 // Index Sync           (+1)

institutBearScore = 0
institutBearScore := institutBearScore + (triggeredBearShift ? 2 : 0)
institutBearScore := institutBearScore + (sweepHigh ? 2 : 0)
institutBearScore := institutBearScore + (bearishAbsorption ? 2 : 0)
institutBearScore := institutBearScore + (bearOteHit ? 2 : 0)
institutBearScore := institutBearScore + (bearSMTDiv ? 2 : 0)
institutBearScore := institutBearScore + (judasSwingBear ? 1 : 0)
institutBearScore := institutBearScore + (po3ManipBear or po3DistBear ? 1 : 0)
institutBearScore := institutBearScore + (bearIFVGRetest ? 1 : 0)
institutBearScore := institutBearScore + (bprBearRetest ? 1 : 0)
institutBearScore := institutBearScore + (htfMajorSell ? 1 : 0)
institutBearScore := institutBearScore + (obSupplyTouch ? 1 : 0)
institutBearScore := institutBearScore + (fvgSupplyRetest ? 1 : 0)
institutBearScore := institutBearScore + (isInKillzone ? 1 : 0)
institutBearScore := institutBearScore + (isNegativeDelta ? 1 : 0)
institutBearScore := institutBearScore + (parentBearConfirmed ? 1 : 0)

// Maximum possible score = 19.
// Calibrated threshold: 5 allows earlier smart entries at origins (Sweeps, OTE, SMT, Early Breakouts)
// Higher scores (7+) represent mature confirmations which often arrive too late!
minInstitScore = input.int(5, 'Minimum Institutional Confluence Score (5 = Early Snipers, 7 = Late Confirmed)', minval = 3, maxval = 12, group = INSTIT_GROUP)
isHighQualityBull = institutBullScore >= minInstitScore and hasPremiumExpansion and not isOverextendedLong
isHighQualityBear = institutBearScore >= minInstitScore and hasPremiumExpansion and not isOverextendedShort

// Recent BOS / Structure Breakout Level Memory
var float lastBullBreakoutLevel = na
var int   lastBullBreakoutBar   = -999
var float lastBearBreakoutLevel = na
var int   lastBearBreakoutBar   = -999

if triggeredBullShift
    lastBullBreakoutLevel := not na(internalHigh.currentLevel) ? internalHigh.currentLevel : high[1]
    lastBullBreakoutBar   := bar_index
if triggeredBearShift
    lastBearBreakoutLevel := not na(internalLow.currentLevel) ? internalLow.currentLevel : low[1]
    lastBearBreakoutBar   := bar_index

// Direct Retest of Breakout Level / Order Block Support:
bullBreakoutRetest = not na(lastBullBreakoutLevel) and (bar_index - lastBullBreakoutBar <= 5) and (low <= lastBullBreakoutLevel + (atr14 * 0.4)) and (close > open)
bearBreakoutRetest = not na(lastBearBreakoutLevel) and (bar_index - lastBearBreakoutBar <= 5) and (high >= lastBearBreakoutLevel - (atr14 * 0.4)) and (close < open)

// Early Turn & Structure Shift Triggers:
// 1. Early CHoCH/BOS on 1-min: Do not require delayed massive displacement if there's already absorption or sweep
isEarlyBullShift = triggeredBullShift and close > open and (isDisplacement or bullishAbsorption or isPositiveDelta)
isEarlyBearShift = triggeredBearShift and close < open and (isDisplacement or bearishAbsorption or isNegativeDelta)

// 2. Pure Liquidity Sweep & Spring/Upthrust Reversal (Enter at the very origin before market takes off!)
sweepSpringBull = sweepLow and close > open and (bullishAbsorption or barDelta > 0 or bullCvdDivergence)
sweepUpthrustBear = sweepHigh and close < open and (bearishAbsorption or barDelta < 0 or bearCvdDivergence)

// ═══════════════════════════════════════════════════════════════════════
// INSTITUTIONAL ENTRY MASTER TRIGGER
// Full Checklist: MSS + Liquidity Sweep + Order Flow + Index Sync + Score
// Now calibrated for EARLIER institutional execution and strict anti-exhaustion
// ═══════════════════════════════════════════════════════════════════════
optionIndexFilter = isCallOption ? parentBullConfirmed : (isPutOption ? parentBearConfirmed : true)

// Institutional Buy Trigger: ALL of the below must align
sniperBuyTrigger =
     isHighQualityBull and          // Must meet institutional score & NOT exhausted/overextended
     optionIndexFilter and          // Parent Index must be aligned with option direction
     orderFlowBullConfirmed and     // Order Flow / Volume Delta / Absorption confirmed
     isInKillzone and               // Active in institutional killzone (avoid chop)
     (
         isEarlyBullShift or        // Early MSS / CHoCH at the turn
         sweepSpringBull or         // Early SSL Sweep + Spring / Absorption (Pre-move entry!)
         bullOteHit or              // OTE Golden Pocket 62%-79% retracement
         bullIFVGRetest or          // Inverted FVG demand zone
         bprBullRetest or           // Balanced Price Range demand zone
         judasSwingBull or          // Judas Swing manipulation reversal
         po3DistBull or             // Power of 3: Distribution phase confirmed
         bullSMTDiv or              // SMT Divergence (Nifty vs BankNifty)
         (bullTrend and (bullBreakoutRetest or (sweepLow and close > open) or obDemandTouch or fvgDemandRetest)) or
         htfMajorBuy                // 15M HTF Sweep + Discount Zone confirmation
     )

// Institutional Sell Trigger: Only on Index/Spot charts, never direct sell on option premium charts
sniperSellTrigger =
     not isOption and               // Options are always "BUY" direction (CE or PE)
     isHighQualityBear and          // Must meet institutional score & NOT exhausted/overextended
     orderFlowBearConfirmed and     // Order Flow / Volume Delta / Absorption confirmed
     isInKillzone and               // Active in institutional killzone
     (
         isEarlyBearShift or        // Early MSS / CHoCH at the turn
         sweepUpthrustBear or       // Early BSL Sweep + Upthrust / Absorption (Pre-move entry!)
         bearOteHit or
         bearIFVGRetest or
         bprBearRetest or
         judasSwingBear or
         po3DistBear or
         bearSMTDiv or
         (bearTrend and (bearBreakoutRetest or (sweepHigh and close < open) or obSupplyTouch or fvgSupplyRetest)) or
         htfMajorSell
     )

// Direct Execution & Retest Management
if enableSniperEngine and not inTrade and (bar_index - lastExitBar >= cooldownBarsInput)
    // ── LONG ENTRY ──
    if sniperBuyTrigger and not pendingOrder
        // Structural low: Cushion SL right below the most recent swing low / SSL sweep origin
        float structLow = not na(internalLow.currentLevel) ? internalLow.currentLevel : low[1]
        if not na(lastBullBreakoutLevel) and lastBullBreakoutLevel < close
            structLow := math.min(structLow, math.min(low, low[1]))
        if sweepLow and not na(swingLow.currentLevel) and swingLow.currentLevel < structLow
            structLow := swingLow.currentLevel
        // OTE-based SL: Place SL at 100% retracement (below OTE swing low origin)
        if bullOteHit and not na(oteSwingLow)
            structLow := math.min(structLow, oteSwingLow)
        // Breathing room: 0.40 ATR on options to prevent 1-min wick hunting
        slBuffer = isOption ? (atr14 * 0.40) : (atr14 * 0.15)
        calcSL    = math.min(structLow, low) - slBuffer
        calcEntry = close
        riskDist  = calcEntry - calcSL

        if riskDist >= (atr14 * minRiskAtr * 0.5)
            inTrade         := true
            tradeDir        := 1
            entryBarIdx     := bar_index
            entryPrice      := calcEntry
            stopLossPrice   := calcSL
            // DOL Target: Use Draw on Liquidity pool (EQH / Previous swing high) as TP if available
            dolTP = hasBullDOL and not na(dolBullTarget) and dolBullTarget > entryPrice + riskDist * 1.5 ? math.min(dolBullTarget, entryPrice + riskDist * 6.0) : na
            targetHighPrice = not na(dolTP) ? dolTP : ((targetOppositeSwing and not na(swingHigh.currentLevel) and swingHigh.currentLevel > entryPrice + riskDist * 2.0) ? math.min(swingHigh.currentLevel, entryPrice + (riskDist * 4.0)) : entryPrice + (riskDist * sniperRRRatio))
            takeProfitPrice := targetHighPrice

            // Label with score and primary reason
            entryReason = bullOteHit ? "OTE" : (bullSMTDiv ? "SMT" : (bullIFVGRetest ? "IFVG" : (bprBullRetest ? "BPR" : (judasSwingBull ? "JUDAS" : (po3DistBull ? "PO3" : "MSS")))))
            activeTPBox := box.new(left=entryBarIdx, top=takeProfitPrice, right=entryBarIdx + 1, bottom=entryPrice,
                                   bgcolor=colTPBox, border_color=color.teal, border_style=line.style_solid)
            activeSLBox := box.new(left=entryBarIdx, top=entryPrice, right=entryBarIdx + 1, bottom=stopLossPrice,
                                   bgcolor=colSLBox, border_color=color.maroon, border_style=line.style_solid)
            buyLabelText = isIndex ? "BUY CALL (CE) " : (isCallOption ? "BUY CALL " : (isPutOption ? "BUY PUT " : "BUY "))
            activeLbl   := label.new(entryBarIdx + 1, entryPrice,
                                     buyLabelText + str.tostring(entryPrice, "#.##") + " | SL: " + str.tostring(stopLossPrice, "#.##") + " | " + entryReason + " [" + str.tostring(institutBullScore) + "/19]",
                                     style=label.style_label_left, color=color(na), textcolor=color.teal, size=size.tiny)

    // ── SHORT ENTRY (Index / Spot charts only) ──
    else if sniperSellTrigger and not pendingOrder
        float structHigh = not na(internalHigh.currentLevel) ? internalHigh.currentLevel : high[1]
        if not na(lastBearBreakoutLevel) and lastBearBreakoutLevel > close
            structHigh := math.max(structHigh, math.max(high, high[1]))
        if sweepHigh and not na(swingHigh.currentLevel) and swingHigh.currentLevel > structHigh
            structHigh := swingHigh.currentLevel
        if bearOteHit and not na(oteSwingHigh)
            structHigh := math.max(structHigh, oteSwingHigh)
        slBuffer = isOption ? (atr14 * 0.40) : (atr14 * 0.15)
        calcSL    = math.max(structHigh, high) + slBuffer
        calcEntry = close
        riskDist  = calcSL - calcEntry

        if riskDist >= (atr14 * minRiskAtr * 0.5)
            inTrade         := true
            tradeDir        := -1
            entryBarIdx     := bar_index
            entryPrice      := calcEntry
            stopLossPrice   := calcSL
            dolTP = hasBearDOL and not na(dolBearTarget) and dolBearTarget < entryPrice - riskDist * 1.5 ? math.max(dolBearTarget, entryPrice - riskDist * 6.0) : na
            targetLowPrice  = not na(dolTP) ? dolTP : ((targetOppositeSwing and not na(swingLow.currentLevel) and swingLow.currentLevel < entryPrice - riskDist * 2.0 and swingLow.currentLevel > 0) ? math.max(swingLow.currentLevel, entryPrice - (riskDist * 4.0)) : entryPrice - (riskDist * sniperRRRatio))
            takeProfitPrice := targetLowPrice

            entryReason = bearOteHit ? "OTE" : (bearSMTDiv ? "SMT" : (bearIFVGRetest ? "IFVG" : (bprBearRetest ? "BPR" : (judasSwingBear ? "JUDAS" : (po3DistBear ? "PO3" : "MSS")))))
            activeTPBox := box.new(left=entryBarIdx, top=entryPrice, right=entryBarIdx + 1, bottom=takeProfitPrice,
                                   bgcolor=colTPBox, border_color=color.teal, border_style=line.style_solid)
            activeSLBox := box.new(left=entryBarIdx, top=stopLossPrice, right=entryBarIdx + 1, bottom=entryPrice,
                                   bgcolor=colSLBox, border_color=color.maroon, border_style=line.style_solid)
            sellLabelText = isIndex ? "BUY PUT (PE) " : "SELL "
            activeLbl   := label.new(entryBarIdx + 1, entryPrice,
                                     sellLabelText + str.tostring(entryPrice, "#.##") + " | SL: " + str.tostring(stopLossPrice, "#.##") + " | " + entryReason + " [" + str.tostring(institutBearScore) + "/19]",
                                     style=label.style_label_left, color=color(na), textcolor=color.maroon, size=size.tiny)

// Active Trade Progression (With Break-Even & Full Swing Target Delivery)
if inTrade
    box.set_right(activeTPBox, bar_index + 1)
    box.set_right(activeSLBox, bar_index + 1)
    label.set_x(activeLbl, bar_index + 1)

    if tradeDir == 1
        // Optional Trailing to Break-Even (Only if explicitly enabled by user)
        if trailToBE and stopLossPrice < entryPrice and high >= (entryPrice + (entryPrice - stopLossPrice) * 2.0)
            stopLossPrice := entryPrice
            box.set_bottom(activeSLBox, entryPrice)
            label.set_text(activeLbl, "BUY (SL @ BE)")

        // Fixed Invalidation SL & TP: Trade stays open until TP or SL is hit
        if high >= takeProfitPrice
            inTrade := false
            lastExitBar := bar_index
            totalWins += 1
            label.new(bar_index, high, "TP HIT (+1:" + str.tostring(sniperRRRatio, "#.#") + ")", style=label.style_label_down, color=color(na), textcolor=color.green, size=size.small)
        else if low <= stopLossPrice
            inTrade := false
            lastExitBar := bar_index
            if trailToBE and stopLossPrice >= entryPrice
                totalWins += 1
                label.new(bar_index, low, "BE EXIT", style=label.style_label_up, color=color(na), textcolor=color.teal, size=size.small)
            else
                totalLosses += 1
                label.new(bar_index, low, "SL HIT", style=label.style_label_up, color=color(na), textcolor=color.red, size=size.small)

    else if tradeDir == -1
        // Optional Trailing to Break-Even (Only if explicitly enabled by user)
        if trailToBE and stopLossPrice > entryPrice and low <= (entryPrice - (stopLossPrice - entryPrice) * 2.0)
            stopLossPrice := entryPrice
            box.set_top(activeSLBox, entryPrice)
            label.set_text(activeLbl, "SELL (SL @ BE)")

        // Fixed Invalidation SL & TP: Trade stays open until TP or SL is hit
        if low <= takeProfitPrice
            inTrade := false
            lastExitBar := bar_index
            totalWins += 1
            label.new(bar_index, low, "TP HIT (+1:" + str.tostring(sniperRRRatio, "#.#") + ")", style=label.style_label_up, color=color(na), textcolor=color.green, size=size.small)
        else if high >= stopLossPrice
            inTrade := false
            lastExitBar := bar_index
            if trailToBE and stopLossPrice <= entryPrice
                totalWins += 1
                label.new(bar_index, high, "BE EXIT", style=label.style_label_down, color=color(na), textcolor=color.teal, size=size.small)
            else
                totalLosses += 1
                label.new(bar_index, high, "SL HIT", style=label.style_label_down, color=color(na), textcolor=color.red, size=size.small)

// Top-Right Scoreboard Table — Institutional HUD (10 rows)
var table dash = table.new(position.top_right, 2, 10, bgcolor=color.new(#131722, 10), border_color=color.new(#2a2e39, 40), border_width=1)

if showSniperScoreboard and barstate.islast
    totalTrades = totalWins + totalLosses
    winRate     = totalTrades > 0 ? (totalWins / totalTrades) * 100.0 : 0.0

    table.cell(dash, 0, 0, "INSTITUTIONAL SNIPER ENGINE", bgcolor=color.new(#1e222d, 0), text_color=color.white, text_size=size.small)
    table.merge_cells(dash, 0, 0, 1, 0)

    table.cell(dash, 0, 1, "Win Rate", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 1, str.tostring(totalWins) + "W - " + str.tostring(totalLosses) + "L (" + str.tostring(winRate, "#.#") + "%)",
               bgcolor=winRate >= 55 ? color.new(color.teal, 30) : color.new(color.maroon, 30), text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 2, "Action State", text_color=color.silver, text_size=size.small)
    statusText = inTrade ? (tradeDir == 1 ? "LONG ACTIVE" : "SHORT ACTIVE") : (pendingOrder ? "WAITING OTE FILL" : "SCANNING...")
    table.cell(dash, 1, 2, statusText, text_color=inTrade ? color.lime : (pendingOrder ? color.orange : color.yellow), text_size=size.small)

    table.cell(dash, 0, 3, "Entry Price", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 3, inTrade ? str.tostring(entryPrice, "#.##") : (pendingOrder ? str.tostring(pendingEntry, "#.##") : "--"), text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 4, "DOL Target (TP)", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 4, inTrade ? str.tostring(takeProfitPrice, "#.##") : (pendingOrder ? str.tostring(pendingTP, "#.##") : "--"), text_color=color.teal, text_size=size.small)

    table.cell(dash, 0, 5, "Structural SL", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 5, inTrade ? str.tostring(stopLossPrice, "#.##") : (pendingOrder ? str.tostring(pendingSL, "#.##") : "--"), text_color=color.maroon, text_size=size.small)

    // Institutional Score HUD
    currentBullScore = institutBullScore
    currentBearScore = institutBearScore
    activeScore = tradeDir == 1 ? currentBullScore : currentBearScore
    scoreColor  = activeScore >= 10 ? color.lime : (activeScore >= 7 ? color.teal : color.orange)
    table.cell(dash, 0, 6, "Instit. Score", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 6, (tradeDir != 0 ? str.tostring(activeScore) : (currentBullScore > currentBearScore ? "BULL " + str.tostring(currentBullScore) : "BEAR " + str.tostring(currentBearScore))) + " / 19",
               bgcolor=color.new(scoreColor, 50), text_color=color.white, text_size=size.small)

    // Order Flow / Delta HUD
    string ofStatus = bullishAbsorption ? "BULL ABSORB" : (bearishAbsorption ? "BEAR ABSORB" : (bullCvdDivergence ? "CVD BULL DIV" : (bearCvdDivergence ? "CVD BEAR DIV" : (barDelta > 0 ? "BUY Δ (+)" : "SELL Δ (-)"))))
    color ofColor   = (bullishAbsorption or bullCvdDivergence or barDelta > 0) ? color.teal : color.maroon
    table.cell(dash, 0, 7, "Order Flow / CVD", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 7, ofStatus, bgcolor=color.new(ofColor, 50), text_color=color.white, text_size=size.small)

    // PO3 Phase HUD
    po3PhaseText = po3Phase == 0 ? "SCAN" : (po3Phase == 1 ? "ACCUMULATION" : (po3Phase == 2 ? "MANIPULATION" : "DISTRIBUTION"))
    po3PhaseCol  = po3Phase == 1 ? color.gray : (po3Phase == 2 ? color.orange : (po3Phase == 3 ? color.lime : color.gray))
    table.cell(dash, 0, 8, "PO3 Phase", text_color=color.silver, text_size=size.small)
    table.cell(dash, 1, 8, po3PhaseText, bgcolor=color.new(po3PhaseCol, 50), text_color=color.white, text_size=size.small)

    // Parent Index Sync HUD Row (for Options Charts)
    if isOption and useIndexSync
        string idxBiasText = indexIsBullish ? "BULLISH (" + parentIndexTicker + ")" : (indexIsBearish ? "BEARISH (" + parentIndexTicker + ")" : "NEUTRAL (" + parentIndexTicker + ")")
        color idxBiasCol   = indexIsBullish ? color.teal : (indexIsBearish ? color.maroon : color.yellow)
        string optPermit   = (isCallOption and parentBullConfirmed) or (isPutOption and parentBearConfirmed) ? " [ALIGNED]" : " [BLOCKED]"
        table.cell(dash, 0, 9, "Index Sync", text_color=color.silver, text_size=size.small)
        table.cell(dash, 1, 9, idxBiasText + optPermit, bgcolor=color.new(idxBiasCol, 50), text_color=color.white, text_size=size.small)
    else
        table.cell(dash, 0, 9, "Chart Mode", text_color=color.silver, text_size=size.small)
        table.cell(dash, 1, 9, isIndex ? "SPOT INDEX" : "EQUITY / CASH", bgcolor=color.new(color.blue, 50), text_color=color.white, text_size=size.small)

//---------------------------------------------------------------------------------------------------------------------}
// ALERTS
//---------------------------------------------------------------------------------------------------------------------{
alertcondition(currentAlerts.internalBullishBOS,        'Internal Bullish BOS',         'Internal Bullish BOS formed')
alertcondition(currentAlerts.internalBullishCHoCH,      'Internal Bullish CHoCH',       'Internal Bullish CHoCH formed')
alertcondition(currentAlerts.internalBearishBOS,        'Internal Bearish BOS',         'Internal Bearish BOS formed')
alertcondition(currentAlerts.internalBearishCHoCH,      'Internal Bearish CHoCH',       'Internal Bearish CHoCH formed')

alertcondition(currentAlerts.swingBullishBOS,           'Swing Bullish BOS',            'Swing Bullish BOS formed')
alertcondition(currentAlerts.swingBullishCHoCH,         'Swing Bullish CHoCH',          'Swing Bullish CHoCH formed')
alertcondition(currentAlerts.swingBearishBOS,           'Swing Bearish BOS',            'Swing Bearish BOS formed')
alertcondition(currentAlerts.swingBearishCHoCH,         'Swing Bearish CHoCH',          'Swing Bearish CHoCH formed')

alertcondition(currentAlerts.internalBullishOrderBlock, 'Bullish Internal OB Breakout', 'Price broke bullish internal OB')
alertcondition(currentAlerts.internalBearishOrderBlock, 'Bearish Internal OB Breakout', 'Price broke bearish internal OB')
alertcondition(currentAlerts.swingBullishOrderBlock,    'Bullish Swing OB Breakout',    'Price broke bullish swing OB')
alertcondition(currentAlerts.swingBearishOrderBlock,    'Bearish Swing OB Breakout',    'Price broke bearish swing OB')

alertcondition(currentAlerts.equalHighs,                'Equal Highs',                  'Equal highs detected')
alertcondition(currentAlerts.equalLows,                 'Equal Lows',                   'Equal lows detected')

alertcondition(currentAlerts.bullishFairValueGap,       'Bullish FVG',                  'Bullish FVG formed')
alertcondition(currentAlerts.bearishFairValueGap,       'Bearish FVG',                  'Bearish FVG formed')

alertcondition(inTrade and inTrade[1] == false and tradeDir == 1,  'Sniper BUY Filled',  'Sniper BUY Filled with small SL!')
alertcondition(inTrade and inTrade[1] == false and tradeDir == -1, 'Sniper SELL Filled', 'Sniper SELL Filled with small SL!') 
